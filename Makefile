PLATFORMS := pk88 tnc2
BUILD_ROOT := build

SDCC ?= $(shell command -v sdcc 2>/dev/null || test ! -x "$(HOME)/bin/sdcc" || printf '%s' "$(HOME)/bin/sdcc")
SDAS ?= $(shell command -v sdasz80 2>/dev/null || test ! -x "$(HOME)/bin/sdasz80" || printf '%s' "$(HOME)/bin/sdasz80")
MAKEBIN ?= $(shell command -v makebin 2>/dev/null || test ! -x "$(HOME)/bin/makebin" || printf '%s' "$(HOME)/bin/makebin")
PYTHON ?= python3

HOSTCC ?= gcc
HOSTCFLAGS := -std=c11 -Wall -Wextra -Werror -Iplatform/pk88 -Iinclude -include tools/host_prefix.h

.PHONY: all pk88 tnc2 firmware clean require-sdcc layout test FORCE

all: pk88 tnc2

pk88:
	$(MAKE) PLATFORM=pk88 firmware

tnc2:
	$(MAKE) PLATFORM=tnc2 firmware

require-sdcc:
	@if test -z "$(SDCC)" || test -z "$(SDAS)" || test -z "$(MAKEBIN)"; then \
		echo "SDCC Z80 tools were not found. sdcc, sdasz80, and makebin must be on PATH."; \
		exit 2; \
	fi

test: $(BUILD_ROOT)/digi_test
	./$(BUILD_ROOT)/digi_test

$(BUILD_ROOT):
	mkdir -p $@

$(BUILD_ROOT)/digi_test: src/digi.c src/dupe.c src/pktq.c src/util.c src/messaging.c tools/digi_test.c include/wfdigi.h include/ax25.h platform/pk88/platform.h tools/host_prefix.h | $(BUILD_ROOT)
	$(HOSTCC) $(HOSTCFLAGS) -DHOST_DIGI_TEST -o $@ src/digi.c src/dupe.c src/pktq.c src/util.c src/messaging.c tools/digi_test.c

clean:
	rm -rf $(BUILD_ROOT)

ifneq ($(PLATFORM),)

ifeq ($(filter $(PLATFORM),$(PLATFORMS)),)
$(error PLATFORM must be one of: $(PLATFORMS))
endif

PROJECT := wfdigi-$(PLATFORM)
BUILD := $(BUILD_ROOT)/$(PLATFORM)
OUTPUT_BIN := $(BUILD_ROOT)/$(PROJECT).bin
CPPFLAGS := -Iplatform/$(PLATFORM) -Iinclude -I$(BUILD)
SDCCFLAGS := -mz80 --std-c11 --opt-code-speed --max-allocs-per-node 10000 $(CPPFLAGS)
LDFLAGS := -mz80 --nostdlib --no-std-crt0 --code-loc 0x0120 --data-loc 0x8100

COMMON_C_SOURCES := src/lamps.c src/serial.c src/config.c src/cli.c src/util.c src/pktq.c src/beacon.c src/telemetry.c src/timer.c src/logging.c src/modem.c src/digi.c src/dupe.c src/messaging.c src/interrupts.c src/main.c
PLATFORM_C_SOURCE := platform/$(PLATFORM)/hardware.c
COMMON_C_OBJECTS := $(patsubst src/%.c,$(BUILD)/%.rel,$(COMMON_C_SOURCES))
PLATFORM_C_OBJECT := $(BUILD)/hardware.rel
ASM_OBJECTS := $(BUILD)/startup.rel $(BUILD)/isr_stubs.rel
OBJECTS := $(ASM_OBJECTS) $(PLATFORM_C_OBJECT) $(COMMON_C_OBJECTS)
HEADERS := include/wfdigi.h include/ax25.h include/config.h include/hardware.h platform/$(PLATFORM)/platform.h

firmware: require-sdcc $(OUTPUT_BIN) layout

$(BUILD):
	mkdir -p $@

# WFDIGI_VERSION is `git describe --tags --always --dirty`. The header is
# rewritten only when that string changes.
$(BUILD)/version.h: FORCE | $(BUILD)
	@set -e; \
	ver=$$(git describe --tags --always --dirty 2>/dev/null || printf '%s' unknown); \
	esc=$$(printf '%s' "$$ver" | sed 's/\\/\\\\/g; s/"/\\"/g'); \
	{ printf '%s\n' '/* Generated by the Makefile. Do not edit. */'; \
	  printf '#define WFDIGI_VERSION "%s"\n' "$$esc"; } > $@.tmp; \
	if test -f $@ && cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

$(BUILD)/%.rel: src/%.c $(HEADERS) | $(BUILD)
	$(SDCC) $(SDCCFLAGS) -c -o $@ $<

$(BUILD)/hardware.rel: $(PLATFORM_C_SOURCE) $(HEADERS) | $(BUILD)
	$(SDCC) $(SDCCFLAGS) -c -o $@ $<

$(BUILD)/main.rel: $(BUILD)/version.h

$(BUILD)/isr_stubs.rel: src/isr_stubs.s | $(BUILD)
	$(SDAS) -plosgff -o $@ $<

$(BUILD)/startup.rel: platform/$(PLATFORM)/startup.s | $(BUILD)
	$(SDAS) -plosgff -o $@ $<

$(BUILD)/$(PROJECT).ihx: $(OBJECTS) Makefile
	$(SDCC) $(LDFLAGS) -Wl-m -o $@ $(OBJECTS)

$(OUTPUT_BIN): $(BUILD)/$(PROJECT).ihx | $(BUILD_ROOT)
	$(MAKEBIN) -s 32768 $< $@

layout: $(OUTPUT_BIN) $(BUILD)/version.h
	$(PYTHON) tools/check-layout.py --platform $(PLATFORM) $(BUILD)/$(PROJECT).ihx $(BUILD)/$(PROJECT).map $(BUILD)/version.h $(OUTPUT_BIN)

endif
